	cd /Users/djsn/Documents/nrf/ble_demo_lp/build_ezurio && $(MAKE) $(MAKESILENT) -f zephyr/subsys/bluetooth/host/CMakeFiles/subsys__bluetooth__host.dir/build.make zephyr/subsys/bluetooth/host/CMakeFiles/subsys__bluetooth__host.dir/uuid.c.i
.PHONY : uuid.c.i

uuid.s: uuid.c.s
.PHONY : uuid.s

# target to generate assembly for a file
uuid.c.s:
	cd /Users/djsn/Documents/nrf/ble_demo_lp/build_ezurio && $(MAKE) $(MAKESILENT) -f zephyr/subsys/bluetooth/host/CMakeFiles/subsys__bluetooth__host.dir/build.make zephyr/subsys/bluetooth/host/CMakeFiles/subsys__bluetooth__host.dir/uuid.c.s
.PHONY : uuid.c.s

